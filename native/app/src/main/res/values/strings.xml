    <string name="share_title">Proxy sharing</string>
    <string name="share_toggle">Share this tunnel\'s proxy</string>
    <string name="share_toggle_desc">Bind the HTTP/SOCKS proxies to the whole network (Wi-Fi + hotspot) and keep LAN traffic out of the VPN</string>
